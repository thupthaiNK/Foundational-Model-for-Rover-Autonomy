// Mars terrain materials — Gazebo built-in textures (confirmed working)
// Project: Onboard Visual Foundation Models for Mars Terrain Perception and Rover Navigation

material Mars/Soil
{
  receive_shadows on
  technique
  {
    pass
    {
      ambient  0.50 0.33 0.22 1.0
      diffuse  0.55 0.36 0.24 1.0
      specular 0.05 0.04 0.03 1.0 8
      texture_unit { texture dirt_diffusespecular.png; scale 0.15 0.15 }
    }
  }
}

material Mars/Bedrock
{
  receive_shadows on
  technique
  {
    pass
    {
      ambient  0.88 0.87 0.85 1.0
      diffuse  0.92 0.91 0.89 1.0
      specular 0.25 0.25 0.25 1.0 24
      texture_unit { texture granite.jpg; scale 0.10 0.10 }
    }
  }
}


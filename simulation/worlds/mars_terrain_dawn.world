  <model name="rock_11"><static>true</static><pose>10.0 -6.0 -0.038 0.1 0.1 3.1</pose>
    <link name="link">
      <collision name="c"><geometry><sphere><radius>0.104</radius></sphere></geometry></collision>
      <visual name="v"><geometry><mesh><uri>model://mars_rock/meshes/model.dae</uri><scale>0.16 0.16 0.16</scale></mesh></geometry>

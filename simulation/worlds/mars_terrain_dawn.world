      <collision name="c"><geometry><sphere><radius>0.130</radius></sphere></geometry></collision>
      <visual name="v"><geometry><mesh><uri>model://mars_rock/meshes/model.dae</uri><scale>0.20 0.20 0.20</scale></mesh></geometry>
        <material><script><uri>model://mars_terrain_tex/materials/scripts</uri><uri>model://mars_terrain_tex/materials/textures</uri><name>Mars/Rock</name></script></material>

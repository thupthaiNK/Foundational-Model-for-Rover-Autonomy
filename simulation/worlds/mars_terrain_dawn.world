  <model name="rock_3"><static>true</static><pose>5.0 -5.0 -0.059 0.2 0 0.2</pose>
    <link name="link">
      <collision name="c"><geometry><sphere><radius>0.163</radius></sphere></geometry></collision>
      <visual name="v"><geometry><mesh><uri>model://mars_rock/meshes/model.dae</uri><scale>0.25 0.25 0.25</scale></mesh></geometry>

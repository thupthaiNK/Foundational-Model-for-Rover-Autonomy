<?xml version="1.0"?>
<!--
  Mars HiRISE qualitative terrain world — Step 7c (qualitative demo only).
  Project: Onboard Visual Foundation Models for Mars Terrain Perception and Rover Navigation

  Purpose:
    Demonstrates the ExoMy rover in a photorealistic Mars terrain derived from
    real HiRISE DTM data (Nili Patera, 1m/pixel resolution). This world is a
    VISUAL DEMO ONLY — no quantitative 5-zone experiment zones are defined.
    Use it to capture "future capability" figures for the thesis: the rover
    placed in real Mars topography, DINOv2 classifying the visible terrain.

  BEFORE LAUNCHING:
    Download the HiRISE mesh (~100MB) and place it at:
      simulation/models/hirise_terrain/meshes/
          DTEEC_050438_1890_051071_1890_Nili Patera Monitoring_10.dae
    See: simulation/models/hirise_terrain/meshes/README.md

  How to run (after mesh downloaded and built):
    source /opt/ros/humble/setup.bash && source ros2_ws/install/setup.bash
    ros2 launch simulation/launch/dinov2_hirise_qualitative.launch.py

  Source of terrain mesh:
    GazeboMarsRover2 (yuzhangbit) — converted from HiRISE DTM with Blender.
    Original HiRISE data: https://www.uahirise.org/dtm/
    Google Drive mesh: https://drive.google.com/file/d/1uM6Z7Rvo_YWs4zVQA1tHq0KJ9TM_AgfF/view
-->
<sdf version="1.6">
<world name="mars_hirise">

  <physics type="ode">
    <real_time_update_rate>1000</real_time_update_rate>
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1</real_time_factor>
  </physics>

  <!-- Mars atmosphere — gravity 3.72 m/s² (vs 9.81 Earth) -->
  <gravity>0 0 -3.72</gravity>

  <scene>
    <ambient>0.35 0.30 0.28 1</ambient>
    <background>0.60 0.40 0.30 1</background>
    <shadows>true</shadows>
    <grid>false</grid>
  </scene>

  <!-- Mars sun — low angle, warm orange-red, strong directional -->
  <light type="directional" name="sun">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 100 0 0 0</pose>
    <diffuse>1.0 0.85 0.70 1</diffuse>
    <specular>0.3 0.3 0.3 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
  </light>

  <!-- Ambient fill — weak, simulates Martian sky scatter -->
  <light type="directional" name="fill">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 50 0 0 0</pose>
    <diffuse>0.20 0.18 0.16 1</diffuse>
    <specular>0.0 0.0 0.0 1</specular>
    <direction>0.5 -0.2 -0.8</direction>
  </light>

  <!-- =================================================================
       HiRISE TERRAIN MODEL
       Mesh: Nili Patera region, 1m/pixel DTM → Blender → DAE
       Source: GazeboMarsRover2 / yuzhangbit (Google Drive ~100MB)

       NOTE: world/collision reference the same mesh. If the mesh is
       missing, Gazebo will start but show a blank world with error:
         [Err] unable to find mesh: model://hirise_terrain/meshes/...
       Download the mesh first — see simulation/models/hirise_terrain/meshes/README.md
  ================================================================= -->
  <model name="hirise_terrain">
    <static>true</static>
    <pose>0 0 0.5 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://hirise_terrain/meshes/DTEEC_050438_1890_051071_1890_Nili Patera Monitoring_10.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://hirise_terrain/meshes/DTEEC_050438_1890_051071_1890_Nili Patera Monitoring_10.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact>
            <ode>
              <soft_cfm>0.2</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+8</kp>
              <kd>10</kd>
              <max_vel>100</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>
  </model>

</world>
</sdf>

<?xml version="1.0"?>
<model>
  <name>mars_terrain_tex</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Thupthai Chaiyadecha</name>
    <email>thupthaich@gmail.com</email>
  </author>
  <description>
    Mars terrain material scripts using real Curiosity NAVCAM textures
    extracted from the AI4Mars dataset (soil/bedrock/sand/big_rock).
    Provides Mars/Soil, Mars/Bedrock, Mars/Sand, Mars/RockGround materials
    for the mars_terrain.world ground planes. Project: Foundational Model
    for Rover Autonomy.
  </description>
</model>
